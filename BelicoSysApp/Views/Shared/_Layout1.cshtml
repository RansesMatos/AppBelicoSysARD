<!DOCTYPE html>
<html id="html" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - BelicoSysApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BelicoSysApp.styles.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>

<body id="body">
       
    @RenderBody()
  
    <footer id="footer" class="border-top footer text-muted bg-primary">
        <div class="container text-white" style="text-align:center">
            &copy; 2023 - Dirreción de Tecnología (TIC), ARD.
        </div>
    </footer>

       @await RenderSectionAsync("Scripts", required: false)
</body>
</html>